# ============================================================
#  CERNIS PRO - Reproduzierbare Build-Werkbank (Linux aarch64)
#  Zweck: Frischer, definierter Container fuer den PyInstaller-
#         /Tauri-Build. Das Repo wird zur LAUFZEIT als Volume
#         nach /build gemountet -- KEIN COPY ins Image, damit
#         die erzeugten deb/rpm auf dem Host sichtbar sind.
#  Basis: debian:12 (bookworm)
#  Die Build-Distro muss der Ziel-Distro entsprechen, weil
#  PyInstaller die System-libpcap bundelt und deren NEEDED-
#  Abhaengigkeiten unter AT_SECURE (setcap) nicht ueber
#  LD_LIBRARY_PATH aufloesbar sind.
#  Bookworm statt Trixie, weil die Rust-Laufzeit auf einer
#  Trixie-Werkbank GLIBC_2.39 ueber die WEAK-Symbole
#  pidfd_spawnp/pidfd_getpid fordert und der Loader auf
#  aelteren Zielen hart abbricht. Bookworm ist der tiefste
#  moegliche Boden: Debian 11 fuehrt kein
#  libwebkit2gtk-4.1-dev.
# ============================================================
FROM debian:12

# Nicht-interaktive apt-Installationen (kein tzdata-Prompt etc.)
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ------------------------------------------------------------
# System-Abhaengigkeiten:
#  - KEIN System-Python: der Build nutzt ausschliesslich das von
#    uv verwaltete Python 3.12 (siehe uv-Abschnitt weiter unten).
#  - Basiswerkzeuge: curl, git, build-essential, ca-certificates
#  - Laufzeit-Deps des Build-Skripts: nmap, libcap2-bin (setcap)
#  - libpcap-Entwicklungspaket: libpcap0.8-dev
#  - Tauri-Linux-Deps: libwebkit2gtk-4.1-dev, libgtk-3-dev,
#    libayatana-appindicator3-dev, librsvg2-dev, patchelf,
#    libssl-dev, pkg-config
#  - Paket-Bundling: file (magic-Erkennung der Bibliotheken),
#    desktop-file-utils (Validierung der .desktop-Datei, die auch
#    der rpm-Bundler erzeugt).
#  - libarchive-tools liefert bsdtar: der Waechter [7b/8] in
#    build-linux.sh entpackt damit das gebaute .rpm und prueft die
#    Beilage am Dateibaum. bsdtar entpackt rpm unmittelbar und
#    braucht dafuer kein zweites Werkzeug.
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        build-essential \
        ca-certificates \
        nmap \
        libcap2-bin \
        libarchive-tools \
        libpcap0.8-dev \
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        patchelf \
        libssl-dev \
        pkg-config \
        file \
        desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Node.js 20 via NodeSource
# ------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# ------------------------------------------------------------
# Rust (stable) via rustup -- global unter /opt/rust, damit der
# Build-User (root im Container) cargo/rustc im PATH hat.
# ------------------------------------------------------------
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo
ENV PATH=/opt/rust/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal \
    && rustc --version && cargo --version

# ------------------------------------------------------------
# uv (offizielles Installskript) -- global nach /usr/local/bin.
# ------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# ------------------------------------------------------------
# Python 3.12 via uv-eigener Toolchain bereitstellen.
# PyInstaller ist mit Python 3.13 inkompatibel; uv liefert eine
# eigene 3.12-Toolchain. Die System-libpcap von Debian wird davon
# nicht beruehrt -- sie ist der eigentliche Grund fuer die
# Debian-Basis.
# ------------------------------------------------------------
RUN uv python install 3.12 && uv python find 3.12

# Arbeitsverzeichnis: hierhin wird das Repo zur Laufzeit gemountet.
WORKDIR /build

CMD ["/bin/bash"]
