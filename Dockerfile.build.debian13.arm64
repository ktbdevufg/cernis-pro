# ============================================================
#  CERNIS PRO - Reproduzierbare Build-Werkbank (Linux aarch64)
#  Zweck: Frischer, definierter Container fuer den PyInstaller-
#         /Tauri-Build. Das Repo wird zur LAUFZEIT als Volume
#         nach /build gemountet -- KEIN COPY ins Image, damit
#         die erzeugten deb/AppImage auf dem Host sichtbar sind.
#  Basis: debian:13 (trixie)
#  Die Build-Distro muss der Ziel-Distro entsprechen, weil
#  PyInstaller die System-libpcap bundelt und deren NEEDED-
#  Abhaengigkeiten unter AT_SECURE (setcap) nicht ueber
#  LD_LIBRARY_PATH aufloesbar sind.
# ============================================================
FROM debian:13

# Nicht-interaktive apt-Installationen (kein tzdata-Prompt etc.)
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ------------------------------------------------------------
# System-Abhaengigkeiten:
#  - KEIN System-Python: der Build nutzt ausschliesslich das von
#    uv verwaltete Python 3.12 (siehe uv-Abschnitt weiter unten).
#  - Basiswerkzeuge: curl, git, build-essential, ca-certificates
#  - Laufzeit-Deps des Build-Skripts: nmap, libcap2-bin (setcap)
#  - libpcap-Entwicklungspaket: libpcap0.8-dev
#  - Tauri-Linux-Deps: libwebkit2gtk-4.1-dev, libgtk-3-dev,
#    libayatana-appindicator3-dev, librsvg2-dev, patchelf,
#    libssl-dev, pkg-config
#  - AppImage-Bundling (linuxdeploy/appimagetool): file (magic-
#    Erkennung der Bibliotheken), desktop-file-utils (Validierung
#    der .desktop-Datei), zsync (Erzeugung der .zsync-Update-Datei).
#    FUSE wird NICHT benoetigt: der Container hat kein /dev/fuse,
#    stattdessen laeuft linuxdeploy/appimagetool via
#    APPIMAGE_EXTRACT_AND_RUN=1 (im Build-Wrapper gesetzt) im
#    Entpack-Modus statt per FUSE-Mount.
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        build-essential \
        ca-certificates \
        nmap \
        libcap2-bin \
        libpcap0.8-dev \
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        patchelf \
        libssl-dev \
        pkg-config \
        file \
        desktop-file-utils \
        zsync \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Node.js 20 via NodeSource
# ------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# ------------------------------------------------------------
# Rust (stable) via rustup -- global unter /opt/rust, damit der
# Build-User (root im Container) cargo/rustc im PATH hat.
# ------------------------------------------------------------
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo
ENV PATH=/opt/rust/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal \
    && rustc --version && cargo --version

# ------------------------------------------------------------
# uv (offizielles Installskript) -- global nach /usr/local/bin.
# ------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# ------------------------------------------------------------
# Python 3.12 via uv-eigener Toolchain bereitstellen.
# PyInstaller ist mit Python 3.13 inkompatibel; uv liefert eine
# eigene 3.12-Toolchain. Die System-libpcap von Debian wird davon
# nicht beruehrt -- sie ist der eigentliche Grund fuer die
# Debian-Basis.
# ------------------------------------------------------------
RUN uv python install 3.12 && uv python find 3.12

# ------------------------------------------------------------
# AppImage-Bundler-Tools vorab in den Cache legen (429-Vermeidung)
#
# WARUM: Beim AppImage-Bundling laedt der tauri-bundler vier
#   externe Hilfswerkzeuge (AppRun, linuxdeploy und die beiden
#   linuxdeploy-Plugins gtk/gstreamer). Diese Downloads treffen
#   GitHub-Release- und raw.githubusercontent-Endpunkte, die im
#   CI sporadisch mit HTTP 429 (Rate-Limit) antworten und den
#   Build dann hart abbrechen.
#
# WIE: Der Bundler prueft vor jedem Download, ob die Datei im
#   tools_path bereits existiert (if !x.exists()) und ueberspringt
#   den Download, wenn sie da ist. tools_path ist
#   dirs::cache_dir()/tauri, und dirs::cache_dir() folgt XDG:
#   $XDG_CACHE_HOME, sonst $HOME/.cache. Wir setzen XDG_CACHE_HOME
#   fest auf /opt/cache -- damit ist der Bundler-Cache
#   deterministisch /opt/cache/tauri, unabhaengig von HOME oder
#   dem ausfuehrenden User. Legen wir die vier Tools hier ins
#   Image, findet der eigentliche CI-Build sie vor und laedt
#   nichts mehr extern. curl mit robustem Retry faengt einen
#   sporadischen 429 bereits beim Image-Build ab.
#
# HINWEIS (ARM): Fuer kuenftige aarch64-Builds werden dieselben
#   Tools mit aarch64-Namen benoetigt (AppRun-aarch64,
#   linuxdeploy-aarch64.AppImage; die beiden Plugin-Skripte sind
#   architekturunabhaengig). Fuer diese aarch64-Werkbank ist genau
#   das oben umgesetzt.
# ------------------------------------------------------------
ENV XDG_CACHE_HOME=/opt/cache
RUN mkdir -p /opt/cache/tauri \
    && curl -fSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o /opt/cache/tauri/AppRun-aarch64 \
        https://github.com/tauri-apps/binary-releases/releases/download/apprun-old/AppRun-aarch64 \
    && curl -fSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o /opt/cache/tauri/linuxdeploy-aarch64.AppImage \
        https://github.com/tauri-apps/binary-releases/releases/download/linuxdeploy/linuxdeploy-aarch64.AppImage \
    && curl -fSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o /opt/cache/tauri/linuxdeploy-plugin-gtk.sh \
        https://raw.githubusercontent.com/tauri-apps/linuxdeploy-plugin-gtk/master/linuxdeploy-plugin-gtk.sh \
    && curl -fSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o /opt/cache/tauri/linuxdeploy-plugin-gstreamer.sh \
        https://raw.githubusercontent.com/tauri-apps/linuxdeploy-plugin-gstreamer/master/linuxdeploy-plugin-gstreamer.sh \
    && chmod +x /opt/cache/tauri/AppRun-aarch64 \
        /opt/cache/tauri/linuxdeploy-aarch64.AppImage \
        /opt/cache/tauri/linuxdeploy-plugin-gtk.sh \
        /opt/cache/tauri/linuxdeploy-plugin-gstreamer.sh \
    && ls -l /opt/cache/tauri

# Arbeitsverzeichnis: hierhin wird das Repo zur Laufzeit gemountet.
WORKDIR /build

CMD ["/bin/bash"]
