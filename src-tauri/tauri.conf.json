{
  "productName": "CernisPro",
  "version": "2.0.0",
  "identifier": "de.cernis.pro",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© 2025 Karl Bach",
    "shortDescription": "LAN Scanner & Monitor",
    "longDescription": "CERNIS PRO - Professional LAN Scanner & Monitor",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis-hooks.nsi"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3t64 | libssl3",
          "libgtk-3-0t64 | libgtk-3-0",
          "libayatana-appindicator3-1",
          "libcap2-bin",
          "nmap",
          "net-tools",
          "traceroute",
          "psmisc",
          "libpcap0.8t64 | libpcap0.8"
        ],
        "preInstallScript": "deb-preinst.sh",
        "postInstallScript": "deb-postinst.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "openssl-libs",
          "libappindicator-gtk3",
          "nmap",
          "net-tools",
          "traceroute",
          "psmisc",
          "libpcap",
          "libcap"
        ],
        "preInstallScript": "rpm-preinst.sh",
        "postInstallScript": "rpm-postinst.sh"
      }
    },
    "externalBin": [
      "cernis-backend",
      "cernis-sniffd"
    ],
    "resources": [
      "../scripts/install-bpf-permissions.sh"
    ]
  }
}