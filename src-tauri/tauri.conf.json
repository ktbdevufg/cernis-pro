{
  "productName": "CernisPro",
  "version": "2.0.0",
  "identifier": "de.cernis.pro",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CERNIS PRO",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://127.0.0.1:8765"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© 2025 Karl Bach",
    "shortDescription": "LAN Scanner & Monitor",
    "longDescription": "CERNIS PRO - Professional LAN Scanner & Monitor",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis-hooks.nsi"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3",
          "libayatana-appindicator3-1",
          "nmap",
          "net-tools",
          "traceroute",
          "psmisc",
          "libpcap0.8"
        ],
        "preInstallScript": "deb-preinst.sh",
        "postInstallScript": "deb-postinst.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "openssl-libs",
          "libappindicator-gtk3",
          "nmap",
          "net-tools",
          "traceroute",
          "psmisc",
          "libpcap"
        ],
        "preInstallScript": "rpm-preinst.sh",
        "postInstallScript": "rpm-postinst.sh"
      }
    },
    "externalBin": [
      "cernis-backend",
      "cernis-sniffd"
    ],
    "resources": [
      "../scripts/install-bpf-permissions.sh"
    ]
  }
}