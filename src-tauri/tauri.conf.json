{
  "productName": "CernisPro",
  "version": "2.1.0",
  "identifier": "de.cernis.pro",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© 2026 Karl Bach",
    "license": "GPL-2.0-only",
    "shortDescription": "LAN Scanner & Monitor",
    "longDescription": "CERNIS PRO - Professional LAN Scanner & Monitor",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis-hooks.nsi",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3t64 | libssl3",
          "libgtk-3-0t64 | libgtk-3-0",
          "libayatana-appindicator3-1",
          "libfribidi0",
          "libcap2-bin",
          "iproute2",
          "iputils-ping",
          "bind9-dnsutils",
          "nmap",
          "traceroute",
          "psmisc",
          "libpcap0.8t64 | libpcap0.8"
        ],
        "recommends": [
          "samba-common-bin"
        ],
        "preInstallScript": "deb-preinst.sh",
        "postInstallScript": "deb-postinst.sh",
        "preRemoveScript": "deb-prerm.sh",
        "postRemoveScript": "deb-postrm.sh",
        "files": {
          "/usr/share/doc/cernis-pro/copyright": "debian/copyright",
          "/usr/share/doc/cernis-pro/3rd-party-licenses.txt.gz": "debian/3rd-party-licenses.txt.gz"
        }
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "libssl.so.3()(64bit)",
          "libcap.so.2()(64bit)",
          "libpcap.so.1()(64bit)",
          "libfribidi.so.0()(64bit)",
          "psmisc",
          "traceroute",
          "iputils",
          "bind-utils",
          "(iproute or iproute2)",
          "(libcap or libcap-progs)"
        ],
        "recommends": [
          "nmap"
        ],
        "preInstallScript": "rpm-preinst.sh",
        "postInstallScript": "rpm-postinst.sh",
        "preRemoveScript": "rpm-prerm.sh",
        "postRemoveScript": "rpm-postrm.sh",
        "files": {
          "/usr/share/licenses/cernis-pro/LICENSE.dependencies": "rpm/LICENSE.dependencies",
          "/usr/share/licenses/cernis-pro/LICENSES": "rpm/LICENSES"
        }
      }
    },
    "externalBin": [
      "cernis-backend",
      "cernis-sniffd"
    ],
    "resources": [
      "lizenzaufstellung.json",
      "LICENSE"
    ]
  }
}