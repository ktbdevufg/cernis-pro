{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for CERNIS PRO",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:event:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:8765/*"]
  }
}
